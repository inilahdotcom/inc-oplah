# api (apps/api/.env)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://inc:inc@localhost:5432/inc_mo
# dipakai test API (database terpisah, di-reset tiap run)
TEST_DATABASE_URL=postgresql://inc:inc@localhost:5432/inc_mo_test
JWT_ACCESS_SECRET=change-me-min-32-chars-xxxxxxxxxxxx
CORS_ORIGINS=http://localhost:5173
# DigitalOcean Spaces (S3). Kosong = fitur upload membalas 503 "Storage belum dikonfigurasi".
# Contoh: S3_ENDPOINT=https://sgp1.digitaloceanspaces.com, S3_REGION=sgp1, S3_BUCKET=inc-mo-dev
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
APP_TIMEZONE=Asia/Jakarta
PUPPETEER_EXECUTABLE_PATH=
SMTP_URL=
# password akun seed (superadmin + akun demo per role di development)
SEED_PASSWORD=password123

# web (apps/web/.env)
VITE_API_BASE_URL=http://localhost:4000/api/v1
